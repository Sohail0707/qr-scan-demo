# Security headers for every page.
# connect-src 'self' means page scripts cannot send data (fetch, beacons, XHR) to any other server.
# form-action 'none' means the page cannot submit a form anywhere.
# To add Plausible later: add https://plausible.io to script-src and connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self'; form-action 'none'; base-uri 'self'; frame-ancestors 'none'
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Scan pages are not for search engines (they duplicate the hub content).
/scan/*
  X-Robots-Tag: noindex
/scan.html
  X-Robots-Tag: noindex
